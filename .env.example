# Environment Configuration Example
# Copy this file to .env and configure your values before running the application.

# Server Port
PORT=5000

# Environment (development or production)
NODE_ENV=development

# Database Connection String (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/a11ai

# JWT Session Encryption Secret (Required in production)
SESSION_SECRET=your-strong-production-secret-key-change-me
