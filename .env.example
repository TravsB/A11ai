# Environment Configuration Example
# Copy this file to .env and replace the placeholder values before running the app.

# Backend server port
PORT=5000

# Runtime mode: development or production
NODE_ENV=development

# Optional local frontend dev server base path
BASE_PATH=/

# PostgreSQL connection string used by the API server
# Example: postgresql://postgres:postgres@localhost:5432/a11ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/a11ai

# Secret used to sign JWT/session tokens.
# For production, use a long random secret.
SESSION_SECRET=change-me-to-a-long-random-secret

# Frontend dev server port
VITE_PORT=5173

# Mockup sandbox dev server port
MOCKUP_PORT=4173
